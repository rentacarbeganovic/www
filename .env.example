# Canonical origin. Canonical, og:url, hreflang, JSON-LD @id and sitemap.xml
# all derive from this. No trailing slash.
# Cloudflare Pages -> Settings -> Environment variables (Production AND Preview).
NUXT_PUBLIC_SITE_URL=https://rentacarbeganovic.com

# Optional. Web3Forms access key (free, https://web3forms.com), registered to
# the reservations inbox. Set: the enquiry form posts straight to the inbox.
# Empty: the form opens the visitor's mail app with the enquiry typed out
# (mailto:). Either way the address is never shown on the page.
NUXT_PUBLIC_WEB3FORMS_KEY=

# Analytics. Set ONE of the two, or neither (then no script loads).
# Plausible: cookieless, no consent banner. Value = the domain in Plausible.
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=
# GA4: sets cookies -> an EU consent banner is required. Looks like G-XXXXXXXXXX
NUXT_PUBLIC_GA_ID=
